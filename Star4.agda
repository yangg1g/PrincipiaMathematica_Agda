module Star4 where

open import Star1
open import Star2
open import Star3

private
  variable
    p q r s : Prop

--  PM's composition of asserted propositions
--  (same Dem. as ∗3·03: [*1·7.*1·72.*2·11]).
Adj : ⊢ p → ⊢ q → ⊢ (p ∙ q)
Adj hp hq = MP hq (MP hp (MP *2·11 *2·32))

--  From ⊢ ((p ⊃ q) ∙ (q ⊃ p)), build  (q ⊃ p) ∙ (p ⊃ q)  (Adj order after  ¬≡).
AdjSwapImp : ⊢ ((p ⊃ q) ∙ (q ⊃ p)) → ⊢ ((q ⊃ p) ∙ (p ⊃ q))
AdjSwapImp th = Adj (MP th *3·27) (MP th *3·26)

--  Left-associated ternary conjunction  (p ∙ q) ∙ r  (nested  Adj).
Adj₃ : ⊢ p → ⊢ q → ⊢ r → ⊢ ((p ∙ q) ∙ r)
Adj₃ hp hq hr = Adj (Adj hp hq) hr

--  Rule form of ∗3·43 (Comp):  ⊢ p⊃q, ⊢ p⊃r  ⇒  ⊢ p⊃(q∙r).
Comp : ⊢ (p ⊃ q) → ⊢ (p ⊃ r) → ⊢ (p ⊃ (q ∙ r))
Comp f g = MP (Adj f g) *3·43

--  Rule form of ∗3·47 (Praeclarum Theorema):  ⊢ p⊃r, ⊢ q⊃s  ⇒  ⊢ p∙q⊃r∙s.
Prael : ⊢ (p ⊃ r) → ⊢ (q ⊃ s) → ⊢ ((p ∙ q) ⊃ (r ∙ s))
Prael f g = MP (Adj f g) *3·47

--  Rule form of ∗3·44:  ⊢ q⊃p, ⊢ r⊃p  ⇒  ⊢ q∨r⊃p.
Cases : ⊢ (q ⊃ p) → ⊢ (r ⊃ p) → ⊢ ((q ∨ r) ⊃ p)
Cases f g = MP (Adj f g) *3·44

------------------------------------------------------------------------
-- ∗4. Equivalence and Formal Rules
--
-- From Whitehead & Russell, Principia Mathematica (1910)
-- (star4_equivalence_and_formal_rules.md)
--
-- Formalized through ∗4·87 (inclusive).
------------------------------------------------------------------------


------------------------------------------------------------------------
-- ∗4·01  p ≡ q .=. p ⊃ q . q ⊃ p    Df
--
--  PM uses the dot for logical product between implications.
------------------------------------------------------------------------

infix 22 _≡_
_≡_ : Prop → Prop → Prop
p ≡ q = (p ⊃ q) ∙ (q ⊃ p)

------------------------------------------------------------------------
-- ∗4·02  p ≡ q ≡ r .=. p ≡ q . q ≡ r    Df
--
--  Chained equivalence: captured by nested  _≡_  when needed.
------------------------------------------------------------------------


------------------------------------------------------------------------
-- ∗4·1  ⊢ : p ⊃ q .≡. ~q ⊃ ~p
--
--  Dem. [*2·16.*2·17]
------------------------------------------------------------------------
*4·1 : ⊢ ((p ⊃ q) ≡ (~ q ⊃ ~ p))
*4·1 = Adj *2·16 *2·17


------------------------------------------------------------------------
-- ∗4·11  ⊢ : p ≡ q .≡. ~p ≡ ~q
--
--  Principle of transposition for equivalence.
--  Dem. [*2·16.*2·17.*3·47.*3·22]
------------------------------------------------------------------------
*4·11 : ⊢ ((p ≡ q) ≡ (~ p ≡ ~ q))
*4·11 = Adj (Syll (Prael *2·16 *2·16) *3·22) (Syll (Prael *2·17 *2·17) *3·22)

*4·11→ : ⊢ ((p ≡ q) ⊃ (~ p ≡ ~ q))
*4·11→ = MP *4·11 *3·26

--  Rule form of ∗4·11:  ⊢ p≡q  ⇒  ⊢ ~p≡~q
¬≡ : ⊢ (p ≡ q) → ⊢ (~ p ≡ ~ q)
¬≡ pq = MP pq *4·11→


------------------------------------------------------------------------
-- ∗4·12  ⊢ : p ≡ ~q .≡. q ≡ ~p
--
--  Dem. [*2·03.*2·15]
------------------------------------------------------------------------
*4·12→ : ⊢ ((p ≡ ~ q) ⊃ (q ≡ ~ p))
*4·12→ = Prael *2·03 *2·15

*4·12 : ⊢ ((p ≡ ~ q) ≡ (q ≡ ~ p))
*4·12 = Adj *4·12→ *4·12→


------------------------------------------------------------------------
-- ∗4·13  ⊢ . p ≡ ~(~p)
--
--  Double negation.
--  Dem. [*2·12.*2·14]
------------------------------------------------------------------------
*4·13 : ⊢ (p ≡ ~ (~ p))
*4·13 = Adj *2·12 *2·14


------------------------------------------------------------------------
-- ∗4·14  ⊢ :. p . q .⊃. r :≡: p . ~r .⊃. ~q
--
--  Dem. [*3·37.*4·13]
------------------------------------------------------------------------
*4·14← : ⊢ (((p ∙ ~ r) ⊃ ~ q) ⊃ ((p ∙ q) ⊃ r))
*4·14← = Syll₃ *3·3 (SumR *2·17) *3·31

*4·14 : ⊢ (((p ∙ q) ⊃ r) ≡ ((p ∙ ~ r) ⊃ ~ q))
*4·14 = Adj *3·37 *4·14←


------------------------------------------------------------------------
-- ∗4·15  ⊢ :. p . q .⊃. ~r :≡: q . r .⊃. ~p
--
--  Dem. [*3·22.*4·13.*4·14]
------------------------------------------------------------------------
*4·15→ : ⊢ (((p ∙ q) ⊃ ~ r) ⊃ ((q ∙ r) ⊃ ~ p))
*4·15→ = Syll₃ (Syll Exp Comm) (SumR *2·03) Imp

*4·15← : ⊢ (((q ∙ r) ⊃ ~ p) ⊃ ((p ∙ q) ⊃ ~ r))
*4·15← = Syll *4·15→ *4·15→

*4·15 : ⊢ (((p ∙ q) ⊃ ~ r) ≡ ((q ∙ r) ⊃ ~ p))
*4·15 = Adj *4·15→ *4·15←


------------------------------------------------------------------------
-- ∗4·2  ⊢ . p ≡ p
--
--  Dem. [Id.*3·2]
------------------------------------------------------------------------
*4·2 : ⊢ (p ≡ p)
*4·2 = Adj Id Id


------------------------------------------------------------------------
-- ∗4·21  ⊢ : p ≡ q .≡. q ≡ p
--
--  Dem. [*3·22]
------------------------------------------------------------------------
*4·21 : ⊢ ((p ≡ q) ≡ (q ≡ p))
*4·21 = Adj *3·22 *3·22

*4·21→ : ⊢ ((p ≡ q) ⊃ (q ≡ p))
*4·21→ = MP *4·21 *3·26

--  Rule form of ∗4·21:  ⊢ p≡q  ⇒  ⊢ q≡p
≡sym : ⊢ (p ≡ q) → ⊢ (q ≡ p)
≡sym pq = MP pq *4·21→


------------------------------------------------------------------------
-- ∗4·22  ⊢ : p ≡ q . q ≡ r .⊃. p ≡ r
--
--  Dem. [*3·26.*3·27.*2·83.Comp]
------------------------------------------------------------------------
*4·22 : ⊢ (((p ≡ q) ∙ (q ≡ r)) ⊃ (p ≡ r))
*4·22 =
  Comp (Syll (Comp (Syll *3·26 *3·26) (Syll *3·27 *3·26)) *3·33)
    (Syll (Comp (Syll *3·27 *3·27) (Syll *3·26 *3·27)) *3·33)

infixr 2 _≡⟨_⟩_ _≡˘⟨_⟩_
infix  3 _∎

_≡⟨_⟩_ : (p : Prop) → ⊢ (p ≡ q) → ⊢ (q ≡ r) → ⊢ (p ≡ r)
_ ≡⟨ p≡q ⟩ q≡r = MP (Adj p≡q q≡r) *4·22

--  From ⊢ (y≡x) and ⊢ (y≡z), infer ⊢ (x≡z)  (common left y).
_≡˘⟨_⟩_ : (x : Prop) {y z : Prop} → ⊢ (y ≡ x) → ⊢ (y ≡ z) → ⊢ (x ≡ z)
x ≡˘⟨ y≡x ⟩ y≡z = MP (Adj (≡sym y≡x) y≡z) *4·22

_∎ : (p : Prop) → ⊢ (p ≡ p)
_ ∎ = *4·2


------------------------------------------------------------------------
-- ∗4·24  ⊢ : p .≡. p . p
--
--  Dem. [*3·26.*3·2.*2·43.*3·2]
------------------------------------------------------------------------
*4·24 : ⊢ (p ≡ (p ∙ p))
*4·24 = Adj (MP *3·2 *2·43) *3·26


------------------------------------------------------------------------
-- ∗4·25  ⊢ : p .≡. p ∨ p
--
--  Dem. [Taut.Add p/q]
------------------------------------------------------------------------
*4·25 : ⊢ (p ≡ (p ∨ p))
*4·25 = Adj Add Taut


------------------------------------------------------------------------
-- ∗4·3  ⊢ : p . q .≡. q . p
--
--  Dem. [*3·22]
------------------------------------------------------------------------
*4·3 : ⊢ ((p ∙ q) ≡ (q ∙ p))
*4·3 = Adj *3·22 *3·22


------------------------------------------------------------------------
-- ∗4·31  ⊢ : p ∨ q .≡. q ∨ p
--
--  Dem. [Perm]
------------------------------------------------------------------------
*4·31 : ⊢ ((p ∨ q) ≡ (q ∨ p))
*4·31 = Adj Perm Perm


------------------------------------------------------------------------
-- ∗4·32  ⊢ : (p . q) . r .≡. p . (q . r)
--
--  Dem. [*4·15.*4·12.*4·11.(*1·01.*3·01)]
------------------------------------------------------------------------
*4·32 : ⊢ (((p ∙ q) ∙ r) ≡ (p ∙ (q ∙ r)))
*4·32 = ¬≡ (Adj (Syll *4·15→ *2·03) (Syll *2·03 *4·15←))


------------------------------------------------------------------------
-- ∗4·33  ⊢ : (p ∨ q) ∨ r .≡. p ∨ (q ∨ r)
--
--  Dem. [*2·31.*2·32]
------------------------------------------------------------------------
*4·33 : ⊢ (((p ∨ q) ∨ r) ≡ (p ∨ (q ∨ r)))
*4·33 = Adj *2·32 *2·31


------------------------------------------------------------------------
-- ∗4·34  p . q . r .=. (p . q) . r    Df
--
--  Agda:  _∙_  is already left-associative  (infixl in Star3).
------------------------------------------------------------------------


------------------------------------------------------------------------
-- ∗4·36  ⊢ :. p ≡ q .⊃: p . r .≡. q . r
--
--  Dem. [Fact.*3·47]
------------------------------------------------------------------------

Fact : ⊢ ((p ⊃ q) ⊃ ((p ∙ r) ⊃ (q ∙ r)))
Fact = *3·45

*4·36 : ⊢ ((p ≡ q) ⊃ ((p ∙ r) ≡ (q ∙ r)))
*4·36 = Comp (Syll *3·26 Fact) (Syll *3·27 Fact)


------------------------------------------------------------------------
-- ∗4·37  ⊢ :. p ≡ q .⊃: p ∨ r .≡. q ∨ r
--
--  Dem. [Sum.*3·47]
------------------------------------------------------------------------
*4·37 : ⊢ ((p ≡ q) ⊃ ((p ∨ r) ≡ (q ∨ r)))
*4·37 = Comp (Syll *3·26 *2·38) (Syll *3·27 *2·38)


--  Same pattern as ∗4·37, but for equivalence on the right of  ≡  (via *3·47).
*4·37r : ⊢ ((p ≡ q) ⊃ ((r ≡ p) ≡ (r ≡ q)))
*4·37r =
  Comp (Syll (Comp (Syll *3·26 *2·05) (Syll *3·27 *2·06)) *3·47)
    (Syll (Comp (Syll *3·27 *2·05) (Syll *3·26 *2·06)) *3·47)


------------------------------------------------------------------------
-- ∗4·38  ⊢ :. p ≡ r . q ≡ s .⊃: p . q .≡. r . s
--
--  Dem. [*3·47.*4·32.*3·22]
------------------------------------------------------------------------
*4·38 : ⊢ (((p ≡ r) ∙ (q ≡ s)) ⊃ ((p ∙ q) ≡ (r ∙ s)))
*4·38 =
  Comp (Syll (Prael *3·26 *3·26) *3·47)
    (Syll (Prael *3·27 *3·27) *3·47)


------------------------------------------------------------------------
-- ∗4·39  ⊢ :. p ≡ r . q ≡ s .⊃: p ∨ q .≡. r ∨ s
--
--  Dem. [*3·48.*3·47.*4·32.*3·22]
------------------------------------------------------------------------
*4·39 : ⊢ (((p ≡ r) ∙ (q ≡ s)) ⊃ ((p ∨ q) ≡ (r ∨ s)))
*4·39 =
  Comp (Syll (Prael *3·26 *3·26) *3·48)
    (Syll (Prael *3·27 *3·27) *3·48)

--  Rule form of ∗4·39:  ⊢ p≡r, ⊢ q≡s  ⇒  ⊢ (p∨q)≡(r∨s)
Or≡ : ⊢ (p ≡ r) → ⊢ (q ≡ s) → ⊢ ((p ∨ q) ≡ (r ∨ s))
Or≡ hp hq = MP (Adj hp hq) *4·39

--  Rule form of ∗4·38:  ⊢ p≡r, ⊢ q≡s  ⇒  ⊢ (p∙q)≡(r∙s)
And≡ : ⊢ (p ≡ r) → ⊢ (q ≡ s) → ⊢ ((p ∙ q) ≡ (r ∙ s))
And≡ hp hq = MP (Adj hp hq) *4·38


------------------------------------------------------------------------
-- ∗4·4  ⊢ :. p . q ∨ r .≡: p . q .∨. p . r
--
--  Dem. [*3·2.Comp.*3·48.Imp.*3·26.*3·27.*3·44.Comp]
------------------------------------------------------------------------
*4·4 : ⊢ ((p ∙ (q ∨ r)) ≡ ((p ∙ q) ∨ (p ∙ r)))
*4·4 =
  Adj (MPImp (Syll (Comp *3·2 *3·2) *3·48))
    (Comp (Cases *3·26 *3·26)
          (Cases (Syll *3·27 *2·2) (Syll *3·27 Add)))


