--  Dem. [*3·26.*3·27.Sum.Comp.*2·53.*3·47.*2·54]
------------------------------------------------------------------------

--  Second conjunct of  *4·41  (Dem. tail only), for explicit instantiation.
*4·41← : ⊢ (((p ∨ q) ∙ (p ∨ r)) ⊃ (p ∨ (q ∙ r)))
*4·41← = Syll₃ (Comp (Syll *3·26 *2·53) (Syll *3·27 *2·53)) *3·43 *2·54

*4·41 : ⊢ ((p ∨ (q ∙ r)) ≡ ((p ∨ q) ∙ (p ∨ r)))
*4·41 =
  Adj (Comp (SumR *3·26) (SumR *3·27))
    *4·41←


