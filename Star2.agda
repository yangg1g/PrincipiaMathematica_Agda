module Star2 where

open import Star1

private
  variable
    p q r s t : Prop

------------------------------------------------------------------------
-- ∗2. Immediate Consequences of the Primitive Propositions
--
-- From Whitehead & Russell, Principia Mathematica (1910)
-- (star2_immediate_consequences.md)
--
-- When a general rule is adduced, it is enclosed in brackets with
-- substitutions (e.g.  Taut ~p/p).  [(1).(*1·01)] rewrites by *1·01.
------------------------------------------------------------------------


------------------------------------------------------------------------
-- ∗2.01  ⊢ : p ⊃ ~p .⊃. ~p
--
--  Principle of the reductio ad absurdum (Abs).
--  "If p implies its own falsehood, then p is false."
--
--  Dem. [Taut ~p/p]  ⊢ : ~p ∨ ~p .⊃. ~p          (1)
--       [(1).(*1.01)] ⊢ : p ⊃ ~p .⊃. ~p
------------------------------------------------------------------------
*2·01 : ⊢ ((p ⊃ ~ p) ⊃ ~ p)
*2·01 = Taut

Abs : ⊢ ((p ⊃ ~ p) ⊃ ~ p)
Abs = *2·01

------------------------------------------------------------------------
-- ∗2.02  ⊢ : q .⊃. p ⊃ q
--
--  Principle of simplification (Simp).
--
--  Dem. [Add ~p/p]   ⊢ : q .⊃. ~p ∨ q             (1)
--       [(1).(*1.01)] ⊢ : q .⊃. p ⊃ q
------------------------------------------------------------------------
*2·02 : ⊢ (q ⊃ p ⊃ q)
*2·02 = Add

Simp : ⊢ (q ⊃ p ⊃ q)
Simp = *2·02

------------------------------------------------------------------------
-- ∗2.03  ⊢ : p ⊃ ~q .⊃. q ⊃ ~p
--
--  Dem. [Perm ~p,~q/p,q]  ⊢ : ~p ∨ ~q .⊃. ~q ∨ ~p  (1)
--       [(1).(*1.01)]      ⊢ : p ⊃ ~q .⊃. q ⊃ ~p
------------------------------------------------------------------------
*2·03 : ⊢ ((p ⊃ ~ q) ⊃ (q ⊃ ~ p))
*2·03 = Perm

------------------------------------------------------------------------
-- ∗2.04  ⊢ :. p .⊃. q ⊃ r :⊃: q .⊃. p ⊃ r
--
--  Commutative principle (Comm).
--
--  Dem. [Assoc ~p,~q/p,q]
--         ⊢ :. ~p ∨ (~q ∨ r) .⊃. ~q ∨ (~p ∨ r)    (1)
--       [(1).(*1.01)]
--         ⊢ :. p .⊃. q ⊃ r :⊃: q .⊃. p ⊃ r
------------------------------------------------------------------------
*2·04 : ⊢ ((p ⊃ q ⊃ r) ⊃ q ⊃ p ⊃ r)
*2·04 = Assoc

Comm : ⊢ ((p ⊃ q ⊃ r) ⊃ q ⊃ p ⊃ r)
Comm = *2·04

--  Rule form of ∗2·04 (Comm):  ⊢ p⊃q⊃r  ⇒  ⊢ q⊃p⊃r
CommR : ⊢ (p ⊃ q ⊃ r) → ⊢ (q ⊃ p ⊃ r)
CommR pqr = MP pqr Comm

------------------------------------------------------------------------
-- ∗2.05  ⊢ : q ⊃ r .⊃: p ⊃ q .⊃. p ⊃ r
--
--  Principle of the syllogism (Syll).
--
--  Dem. [Sum ~p/p]
--         ⊢ :. q ⊃ r .⊃: ~p ∨ q .⊃. ~p ∨ r       (1)
--       [(1).(*1.01)]
--         ⊢ :. q ⊃ r .⊃: p ⊃ q .⊃. p ⊃ r
------------------------------------------------------------------------
*2·05 : ⊢ ((q ⊃ r) ⊃ (p ⊃ q) ⊃ (p ⊃ r))
*2·05 = Sum

------------------------------------------------------------------------
-- Derived rule: SumR  (summation as a rule of inference)
--
--   From  ⊢ q ⊃ r,  infer  ⊢ p ∨ q .⊃. p ∨ r.
--   Same lemma as ∗2·05 (= Sum).
------------------------------------------------------------------------

SumR : ⊢ (q ⊃ r) → ⊢ (p ∨ q ⊃ p ∨ r)
SumR qr = MP qr Sum

------------------------------------------------------------------------
-- ∗2.06  ⊢ : p ⊃ q .⊃: q ⊃ r .⊃. p ⊃ r
--
--  Principle of the syllogism (Syll).
--
--  Dem. [Comm (q⊃r)/(p), (p⊃q)/(q), (p⊃r)/(r)]
--         ⊢ :: q ⊃ r .⊃: p ⊃ q .⊃. p ⊃ r
--           :⊃: p ⊃ q .⊃: q ⊃ r .⊃. p ⊃ r        (1)
--       [*2.05]
--         ⊢ :: q ⊃ r .⊃: p ⊃ q .⊃. p ⊃ r          (2)
--       [(1).(2).*1.11]
--         ⊢ :. p ⊃ q .⊃: q ⊃ r .⊃. p ⊃ r
------------------------------------------------------------------------
*2·06 : ⊢ ((p ⊃ q) ⊃ (q ⊃ r) ⊃ (p ⊃ r))
*2·06 = MP *2·05 *2·04

--  Rule form of ∗2·06:  ⊢ p⊃q  ⇒  ⊢ ((q⊃r)⊃(p⊃r))
SyllImp : ⊢ (p ⊃ q) → ⊢ ((q ⊃ r) ⊃ (p ⊃ r))
SyllImp pq = MP pq *2·06

------------------------------------------------------------------------
-- Derived rule: Syll  (syllogism as a rule of inference)
--
--   From  ⊢ p ⊃ q  and  ⊢ q ⊃ r,  infer  ⊢ p ⊃ r.
--
-- Corresponds to the PM abbreviation
--   [Syll] ⊢ .(a).(b). ⊃ ⊢ .(c)
-- where (a) : p₁ ⊃ p₂, (b) : p₂ ⊃ p₃, (c) : p₁ ⊃ p₃.
------------------------------------------------------------------------

Syll : ⊢ (p ⊃ q) → ⊢ (q ⊃ r) → ⊢ (p ⊃ r)
Syll pq qr = MP pq (SumR qr)

------------------------------------------------------------------------
-- Derived rule: Syll₃  (three-step syllogism)
--
--   From  ⊢ p ⊃ q,  ⊢ q ⊃ r,  ⊢ r ⊃ s,  infer  ⊢ p ⊃ s.
------------------------------------------------------------------------

Syll₃ : ⊢ (p ⊃ q) → ⊢ (q ⊃ r) → ⊢ (r ⊃ s) → ⊢ (p ⊃ s)
Syll₃ pq qr rs = Syll (Syll pq qr) rs

------------------------------------------------------------------------
-- Derived rule: Syll₄  (four-step syllogism)
--
--   From  ⊢ p ⊃ q,  ⊢ q ⊃ r,  ⊢ r ⊃ s,  ⊢ s ⊃ t,  infer  ⊢ p ⊃ t.
------------------------------------------------------------------------

Syll₄ : ⊢ (p ⊃ q) → ⊢ (q ⊃ r) → ⊢ (r ⊃ s) → ⊢ (s ⊃ t) → ⊢ (p ⊃ t)
Syll₄ pq qr rs st = Syll (Syll₃ pq qr rs) st

------------------------------------------------------------------------
-- ∗2.07  ⊢ : p .⊃. p ∨ p
--
--  Dem. [*1.3 p/q]
------------------------------------------------------------------------
*2·07 : ⊢ (p ⊃ p ∨ p)
*2·07 = *1·3

------------------------------------------------------------------------
-- ∗2.08  ⊢ . p ⊃ p
--
--  Principle of identity (Id).
--
--  Dem. [*2.05 p∨p,p/q,r]
--         ⊢ :: p ∨ p .⊃. p :⊃:. p .⊃. p ∨ p :⊃. p ⊃ p    (1)
--       [Taut]
--         ⊢ : p ∨ p .⊃. p                                   (2)
--       [(1).(2).*1.11]
--         ⊢ :. p .⊃. p ∨ p :⊃. p ⊃ p                       (3)
--       [*2.07]
--         ⊢ : p .⊃. p ∨ p                                   (4)
--       [(3).(4).*1.11]
--         ⊢ . p ⊃ p
------------------------------------------------------------------------
*2·08 : ⊢ (p ⊃ p)
*2·08 = MP *2·07 (SumR Taut)

Id : ⊢ (p ⊃ p)
Id = *2·08

------------------------------------------------------------------------
-- ∗2.1  ⊢ . ~p ∨ p
--
--  Dem. [*2.08.(*1.01)]
--       p ⊃ p  =  ~p ∨ p   by definition.
------------------------------------------------------------------------
*2·1 : ⊢ (~ p ∨ p)
*2·1 = *2·08

------------------------------------------------------------------------
-- ∗2.11  ⊢ . p ∨ ~p
--
--  Law of excluded middle.
--
--  Dem. [Perm ~p,p/p,q]  ⊢ : ~p ∨ p .⊃. p ∨ ~p     (1)
--       [(1).*2.1.*1.11]  ⊢ . p ∨ ~p
------------------------------------------------------------------------
*2·11 : ⊢ (p ∨ ~ p)
*2·11 = MP *2·1 Perm

------------------------------------------------------------------------
-- ∗2.12  ⊢ . p ⊃ ~~p
--
--  Dem. [*2.11 ~p/p]  ⊢ . ~p ∨ ~~p                  (1)
--       [(1).(*1.01)]  ⊢ . p ⊃ ~~p
------------------------------------------------------------------------
*2·12 : ⊢ (p ⊃ ~ (~ p))
*2·12 = *2·11

------------------------------------------------------------------------
-- ∗2.13  ⊢ . p ∨ ~{~~p}
--
--  Lemma for ∗2.14.
--
--  Dem. [Sum p,~p,~{~~p}/p,q,r]
--         ⊢ : ~p .⊃. ~{~~p} .⊃: p ∨ ~p .⊃. p ∨ ~{~~p}    (1)
--       [*2.12 ~p/p]
--         ⊢ : ~p .⊃. ~{~~p}                                 (2)
--       [(1).(2).*1.11]
--         ⊢ : p ∨ ~p .⊃. p ∨ ~{~~p}                        (3)
--       [(3).*2.11.*1.11]
--         ⊢ . p ∨ ~{~~p}
------------------------------------------------------------------------
*2·13 : ⊢ (p ∨ ~ (~ (~ p)))
*2·13 = MP *2·11 (SumR *2·12)

------------------------------------------------------------------------
-- ∗2.14  ⊢ . ~~p ⊃ p
--
--  Dem. [Perm ~{~~p}/q]
--         ⊢ : p ∨ ~{~~p} .⊃. ~{~~p} ∨ p                    (1)
--       [(1).*2.13.*1.11]
--         ⊢ . ~{~~p} ∨ p                                    (2)
--       [(2).(*1.01)]
--         ⊢ . ~~p ⊃ p
------------------------------------------------------------------------
*2·14 : ⊢ (~ (~ p) ⊃ p)
*2·14 = MP *2·13 Perm

------------------------------------------------------------------------
-- ∗2.15  ⊢ : ~p ⊃ q .⊃. ~q ⊃ p
--
--  Principle of transposition (Transp).
--
--  Dem. Long proof in star2_immediate_consequences.md; PM abbreviates
--       chains of implications as [Syll].  Here: *2·12.*2·05; *2·03;
--       *2·14.*2·05 with Syll.
------------------------------------------------------------------------
*2·15 : ⊢ ((~ p ⊃ q) ⊃ (~ q ⊃ p))
*2·15 = Syll₃ (SumR *2·12) *2·03 (SumR *2·14)

------------------------------------------------------------------------
-- ∗2.16  ⊢ : p ⊃ q .⊃. ~q ⊃ ~p
--
--  Principle of transposition (Transp).
--
--  Dem.  (1) ⊢ (p ⊃ q) ⊃ (p ⊃ ~~q)          [*2.12.*2.05]
--        (2) ⊢ (p ⊃ ~~q) ⊃ (~q ⊃ ~p)         [*2.03 ~q/q]
--        Syll (1)(2)
------------------------------------------------------------------------
*2·16 : ⊢ ((p ⊃ q) ⊃ (~ q ⊃ ~ p))
*2·16 = Syll (SumR *2·12) *2·03

------------------------------------------------------------------------
-- ∗2.17  ⊢ : ~q ⊃ ~p .⊃. p ⊃ q
--
--  Principle of transposition (Transp).
--
--  Dem.  (1) ⊢ (~q ⊃ ~p) ⊃ (p ⊃ ~~q)        [*2.03 ~q,p/p,q]
--        (2) ⊢ (p ⊃ ~~q) ⊃ (p ⊃ q)            [*2.14.*2.05]
--        Syll (1)(2)
------------------------------------------------------------------------
*2·17 : ⊢ ((~ q ⊃ ~ p) ⊃ (p ⊃ q))
*2·17 = Syll *2·03 (SumR *2·14)

------------------------------------------------------------------------
-- ∗2.18  ⊢ : ~p ⊃ p .⊃. p
--
--  "A proposition which follows from the hypothesis of
--   its own falsehood is true."
--
--  Dem.  (1) ⊢ (~p ⊃ p) ⊃ (~p ⊃ ~~p)        [*2·12.*2·05]
--        (2) ⊢ (~p ⊃ ~~p) ⊃ ~~p               [*2·01 ~p/p]
--        (3) Syll (1)(2)
--        (4) ⊢ ~~p ⊃ p                         [*2·14]
--        Syll (3)(4)
------------------------------------------------------------------------
*2·18 : ⊢ ((~ p ⊃ p) ⊃ p)
*2·18 = Syll₃ (SumR *2·12) *2·01 *2·14

------------------------------------------------------------------------
-- ∗2.15, ∗2.16, ∗2.17 are all forms of the
-- principle of transposition (Transp).
--
-- We adopt ∗2.16 as the canonical alias.
------------------------------------------------------------------------

Transp : ⊢ ((p ⊃ q) ⊃ (~ q ⊃ ~ p))
Transp = *2·16

--  Rule form of ∗2·16 (Transp):  ⊢ p⊃q  ⇒  ⊢ ~q⊃~p
TranspR : ⊢ (p ⊃ q) → ⊢ (~ q ⊃ ~ p)
TranspR pq = MP pq Transp

------------------------------------------------------------------------
-- ∗2.2  ⊢ : p .⊃. p ∨ q
--
--  Dem. ⊢ .Add.⊃ ⊢ : p .⊃. q ∨ p                      (1)
--       [Perm]   ⊢ : q ∨ p .⊃. p ∨ q                    (2)
--       [Syll] ⊢ .(1).(2).⊃ ⊢ .Prop
------------------------------------------------------------------------
*2·2 : ⊢ (p ⊃ p ∨ q)
*2·2 = Syll Add Perm

------------------------------------------------------------------------
-- ∗2.21  ⊢ : ~p .⊃. p ⊃ q
--
--  "A false proposition implies any proposition."
--
--  Dem. [*2.2 ~p/p]
------------------------------------------------------------------------
*2·21 : ⊢ (~ p ⊃ p ⊃ q)
*2·21 = *2·2

------------------------------------------------------------------------
-- ∗2.24  ⊢ : p .⊃. ~p ⊃ q
--
--  Dem. [*2.21.Comm]
------------------------------------------------------------------------
*2·24 : ⊢ (p ⊃ ~ p ⊃ q)
*2·24 = CommR *2·21

------------------------------------------------------------------------
-- ∗2.25  ⊢ :. p :∨: p ∨ q .⊃. q
--
--  Dem. ⊢ .*2.1.⊃ ⊢ : ~(p ∨ q) .∨. (p ∨ q) :
--       [Assoc]  ⊃ ⊢ : p .∨. {~(p ∨ q) .∨. q}
------------------------------------------------------------------------
*2·25 : ⊢ (p ∨ ((p ∨ q) ⊃ q))
*2·25 = MP *2·1 Assoc

------------------------------------------------------------------------
-- ∗2.26  ⊢ : ~p :∨: p ⊃ q .⊃. q
--
--  Dem. [*2.25 ~p/p]
------------------------------------------------------------------------
*2·26 : ⊢ (~ p ∨ ((p ⊃ q) ⊃ q))
*2·26 = *2·25

------------------------------------------------------------------------
-- ∗2.27  ⊢ :. p .⊃: p ⊃ q .⊃. q
--
--  Dem. [*2.26]
------------------------------------------------------------------------
*2·27 : ⊢ (p ⊃ (p ⊃ q) ⊃ q)
*2·27 = *2·26

------------------------------------------------------------------------
-- ∗2.3  ⊢ : p ∨ (q ∨ r) .⊃. p ∨ (r ∨ q)
--
--  Dem. [Perm q,r/p,q]  ⊢ : q ∨ r .⊃. r ∨ q :
--       [Sum]           ⊃ ⊢ : p ∨ (q ∨ r) .⊃. p ∨ (r ∨ q)
------------------------------------------------------------------------
*2·3 : ⊢ (p ∨ (q ∨ r) ⊃ p ∨ (r ∨ q))
*2·3 = SumR Perm

------------------------------------------------------------------------
-- ∗2.31  ⊢ : p ∨ (q ∨ r) .⊃. (p ∨ q) ∨ r
--
--  Dem. [*2.3]    ⊢ : p ∨ (q ∨ r) .⊃. p ∨ (r ∨ q)
--       [Assoc]   ⊃ . r ∨ (p ∨ q)
--       [Perm]    ⊃ . (p ∨ q) ∨ r  :⊃ ⊢ .Prop
------------------------------------------------------------------------
*2·31 : ⊢ (p ∨ (q ∨ r) ⊃ (p ∨ q) ∨ r)
*2·31 = Syll₃ *2·3 Assoc Perm

------------------------------------------------------------------------
-- ∗2.32  ⊢ : (p ∨ q) ∨ r .⊃. p ∨ (q ∨ r)
--
--  Dem. [Perm]    ⊢ : (p ∨ q) ∨ r .⊃. r ∨ (p ∨ q)
--       [Assoc]   ⊃ . p ∨ (r ∨ q)
--       [*2.3]    ⊃ . p ∨ (q ∨ r)  :⊃ ⊢ .Prop
------------------------------------------------------------------------
*2·32 : ⊢ ((p ∨ q) ∨ r ⊃ p ∨ (q ∨ r))
*2·32 = Syll₃ Perm Assoc *2·3

------------------------------------------------------------------------
-- ∗2.33  p ∨ q ∨ r .=. (p ∨ q) ∨ r    Df
--
--  Captured by  infixl 30 _∨_  in Star1.
------------------------------------------------------------------------

------------------------------------------------------------------------
-- ∗2.36  ⊢ :. q ⊃ r .⊃: p ∨ q .⊃. r ∨ p
--
--  Dem. [Perm]   ⊢ : p ∨ r .⊃. r ∨ p :
--       [Syll]   ⊃ ⊢ :. p ∨ q .⊃. p ∨ r
--                   :⊃: p ∨ q .⊃. r ∨ p        (1)
--       [Sum]    ⊢ :. q ⊃ r .⊃: p ∨ q .⊃. p ∨ r   (2)
--       ⊢ .(2).(1).Syll.⊃ .Prop
------------------------------------------------------------------------
*2·36 : ⊢ ((q ⊃ r) ⊃ (p ∨ q ⊃ r ∨ p))
*2·36 = Syll Sum (SumR Perm)

------------------------------------------------------------------------
-- ∗2.37  ⊢ :. q ⊃ r .⊃: q ∨ p .⊃. p ∨ r
--
--  Dem. [Syll.Perm.Sum]
------------------------------------------------------------------------
*2·37 : ⊢ ((q ⊃ r) ⊃ (q ∨ p ⊃ p ∨ r))
*2·37 = Syll Sum (SyllImp Perm)

------------------------------------------------------------------------
-- ∗2.38  ⊢ :. q ⊃ r .⊃: q ∨ p .⊃. r ∨ p
--
--  Dem. [Syll.Perm.Sum]
------------------------------------------------------------------------
*2·38 : ⊢ ((q ⊃ r) ⊃ (q ∨ p ⊃ r ∨ p))
*2·38 = Syll *2·37 (SumR Perm)

--  Rule form of ∗2·38:  ⊢ q⊃r  ⇒  ⊢ ((q∨p)⊃(r∨p))
SyllOr : ⊢ (q ⊃ r) → ⊢ ((q ∨ p) ⊃ (r ∨ p))
SyllOr qr = MP qr *2·38

------------------------------------------------------------------------
-- ∗2.4  ⊢ :. p .∨. p ∨ q :⊃. p ∨ q
--
--  Dem. ⊢ .*2.31.⊃ ⊢ : p .∨. p ∨ q :⊃: p ∨ p .∨. q :
--       [Taut.*2.38]  ⊃ : p ∨ q :.⊃ ⊢ .Prop
------------------------------------------------------------------------
*2·4 : ⊢ (p ∨ (p ∨ q) ⊃ p ∨ q)
*2·4 = Syll *2·31 (SyllOr Taut)

------------------------------------------------------------------------
-- ∗2.41  ⊢ : q .∨. p ∨ q :⊃. p ∨ q
--
--  Dem. [Assoc q,p,q/p,q,r]
--         ⊢ :. q .∨. p ∨ q :⊃: p .∨. q ∨ q :
--       [Taut.Sum]  ⊃ : p ∨ q :⊃ .Prop
------------------------------------------------------------------------
*2·41 : ⊢ (q ∨ (p ∨ q) ⊃ p ∨ q)
*2·41 = Syll Assoc (SumR Taut)

------------------------------------------------------------------------
-- ∗2.42  ⊢ :. ~p .∨. p ⊃ q :⊃. p ⊃ q
--
--  Dem. [*2.4 ~p/p]
------------------------------------------------------------------------
*2·42 : ⊢ (~ p ∨ (p ⊃ q) ⊃ (p ⊃ q))
*2·42 = *2·4

------------------------------------------------------------------------
-- ∗2.43  ⊢ :. p .⊃. p ⊃ q :⊃. p ⊃ q
--
--  Dem. [*2.42]
------------------------------------------------------------------------
*2·43 : ⊢ ((p ⊃ p ⊃ q) ⊃ p ⊃ q)
*2·43 = *2·42

------------------------------------------------------------------------
-- ∗2.45  ⊢ : ~(p ∨ q) .⊃. ~p
--
--  Dem. [*2.2.Transp]
------------------------------------------------------------------------
*2·45 : ⊢ (~ (p ∨ q) ⊃ ~ p)
*2·45 = TranspR *2·2

------------------------------------------------------------------------
-- ∗2.46  ⊢ : ~(p ∨ q) .⊃. ~q
--
--  Dem. [*1.3.Transp]
------------------------------------------------------------------------
*2·46 : ⊢ (~ (p ∨ q) ⊃ ~ q)
*2·46 = TranspR Add

------------------------------------------------------------------------
-- ∗2.47  ⊢ : ~(p ∨ q) .⊃. ~p ∨ q
--
--  Dem. [*2.45.*2.2 ~p/p.Syll]
------------------------------------------------------------------------
*2·47 : ⊢ (~ (p ∨ q) ⊃ ~ p ∨ q)
*2·47 = Syll *2·45 *2·2

------------------------------------------------------------------------
-- ∗2.48  ⊢ : ~(p ∨ q) .⊃. p ∨ ~q
--
--  Dem. [*2.46.*1.3 ~q/q.Syll]
------------------------------------------------------------------------
*2·48 : ⊢ (~ (p ∨ q) ⊃ p ∨ ~ q)
*2·48 = Syll *2·46 Add

------------------------------------------------------------------------
-- ∗2.49  ⊢ : ~(p ∨ q) .⊃. ~p ∨ ~q
--
--  Dem. [*2.45.*2.2 ~p,~q/p,q.Syll]
------------------------------------------------------------------------
*2·49 : ⊢ (~ (p ∨ q) ⊃ ~ p ∨ ~ q)
*2·49 = Syll *2·45 *2·2

------------------------------------------------------------------------
-- ∗2.5  ⊢ : ~(p ⊃ q) .⊃. ~p ⊃ q
--
--  Dem. [*2.47 ~p/p]
------------------------------------------------------------------------
*2·5 : ⊢ (~ (p ⊃ q) ⊃ (~ p ⊃ q))
*2·5 = *2·47

------------------------------------------------------------------------
-- ∗2.51  ⊢ : ~(p ⊃ q) .⊃. p ⊃ ~q
--
--  Dem. [*2.48 ~p/p]
------------------------------------------------------------------------
*2·51 : ⊢ (~ (p ⊃ q) ⊃ (p ⊃ ~ q))
*2·51 = *2·48

------------------------------------------------------------------------
-- ∗2.52  ⊢ : ~(p ⊃ q) .⊃. ~p ⊃ ~q
--
--  Dem. [*2.49 ~p/p]
------------------------------------------------------------------------
*2·52 : ⊢ (~ (p ⊃ q) ⊃ (~ p ⊃ ~ q))
*2·52 = *2·49

------------------------------------------------------------------------
-- ∗2.521  ⊢ : ~(p ⊃ q) .⊃. q ⊃ p
--
--  Dem. [*2.52.*2.17]
------------------------------------------------------------------------
*2·521 : ⊢ (~ (p ⊃ q) ⊃ (q ⊃ p))
*2·521 = Syll *2·52 *2·17

------------------------------------------------------------------------
-- ∗2.53  ⊢ : p ∨ q .⊃. ~p ⊃ q
--
--  Dem. ⊢ .*2.12.*2.38.⊃ ⊢ : p ∨ q .⊃. ~~p ∨ q
--       :⊃ ⊢ .Prop
------------------------------------------------------------------------
*2·53 : ⊢ (p ∨ q ⊃ (~ p ⊃ q))
*2·53 = SyllOr *2·12

------------------------------------------------------------------------
-- ∗2.54  ⊢ : ~p ⊃ q .⊃. p ∨ q
--
--  Dem. [*2.14.*2.38]
------------------------------------------------------------------------
*2·54 : ⊢ ((~ p ⊃ q) ⊃ p ∨ q)
*2·54 = SyllOr *2·14

------------------------------------------------------------------------
-- ∗2.55  ⊢ : ~p .⊃: p ∨ q .⊃. q
--
--  Dem. [*2.53.Comm]
------------------------------------------------------------------------
*2·55 : ⊢ (~ p ⊃ (p ∨ q) ⊃ q)
*2·55 = CommR *2·53

------------------------------------------------------------------------
-- ∗2.56  ⊢ : ~q .⊃: p ∨ q .⊃. p
--
--  Dem. [*2.55 q,p/p,q.Perm]
------------------------------------------------------------------------
*2·56 : ⊢ (~ q ⊃ (p ∨ q) ⊃ p)
*2·56 = CommR (Syll Perm *2·53)

------------------------------------------------------------------------
-- ∗2.6  ⊢ : ~p ⊃ q .⊃: p ⊃ q .⊃. q
--
--  Dem.  [*2.38]  ⊢ : ~p ⊃ q .⊃: ~p ∨ q .⊃. q ∨ q        (1)
--        [Taut.Syll]
--          ⊢ : ~p ∨ q .⊃. q ∨ q :⊃: ~p ∨ q .⊃. q          (2)
--        [(1).(2).Syll]  ⊢ .Prop
------------------------------------------------------------------------
*2·6 : ⊢ ((~ p ⊃ q) ⊃ (p ⊃ q) ⊃ q)
*2·6 = Syll *2·38 (SumR Taut)

------------------------------------------------------------------------
-- ∗2.61  ⊢ :. p ⊃ q .⊃: ~p ⊃ q .⊃. q
--
--  Dem. [*2.6.Comm]
------------------------------------------------------------------------
*2·61 : ⊢ ((p ⊃ q) ⊃ (~ p ⊃ q) ⊃ q)
*2·61 = CommR *2·6

------------------------------------------------------------------------
-- ∗2.62  ⊢ : p ∨ q .⊃: p ⊃ q .⊃. q
--
--  Dem. [*2.53.*2.6.Syll]
------------------------------------------------------------------------
*2·62 : ⊢ (p ∨ q ⊃ (p ⊃ q) ⊃ q)
*2·62 = Syll *2·53 *2·6

------------------------------------------------------------------------
-- ∗2.621  ⊢ :. p ⊃ q .⊃: p ∨ q .⊃. q
--
--  Dem. [*2.62.Comm]
------------------------------------------------------------------------
*2·621 : ⊢ ((p ⊃ q) ⊃ (p ∨ q) ⊃ q)
*2·621 = CommR *2·62

------------------------------------------------------------------------
-- ∗2.63  ⊢ : p ∨ q .⊃: ~p ∨ q .⊃. q
--
--  Dem. [*2·62]
------------------------------------------------------------------------
*2·63 : ⊢ (p ∨ q ⊃ (~ p ∨ q ⊃ q))
*2·63 = *2·62

------------------------------------------------------------------------
-- ∗2.64  ⊢ : p ∨ q .⊃: p ∨ ~q .⊃. p
--
--  Dem. [*2·63 q,p/p,q.Perm]
------------------------------------------------------------------------
*2·64 : ⊢ (p ∨ q ⊃ (p ∨ ~ q) ⊃ p)
*2·64 = Syll₃ Perm *2·63 (SyllImp Perm)

------------------------------------------------------------------------
-- ∗2.65  ⊢ : p ⊃ q .⊃: p ⊃ ~q .⊃. ~p
--
--  Dem. [*2·64 ~p/p]
------------------------------------------------------------------------
*2·65 : ⊢ ((p ⊃ q) ⊃ (p ⊃ ~ q) ⊃ ~ p)
*2·65 = *2·64

------------------------------------------------------------------------
-- ∗2.67  ⊢ :. p ∨ q .⊃. q :⊃. p ⊃ q
--
--  Dem.  [*2.54.Syll]
--          ⊢ :. p ∨ q .⊃. q :⊃: ~p ⊃ q .⊃. q              (1)
--        [*2.24.Syll]
--          ⊢ :. ~p ⊃ q .⊃. q :⊃. p ⊃ q                     (2)
--        [(1).(2).Syll]  ⊢ .Prop
------------------------------------------------------------------------
*2·67 : ⊢ (((p ∨ q) ⊃ q) ⊃ (p ⊃ q))
*2·67 = Syll (SyllImp *2·54) (SyllImp *2·24)

------------------------------------------------------------------------
-- ∗2.68  ⊢ : p ⊃ q .⊃. q :⊃. p ∨ q
--
--  Dem.  [*2.67 ~p/p]
--          ⊢ :. p ⊃ q .⊃. q :⊃. ~p ⊃ q                     (1)
--        [(1).*2.54]  ⊢ .Prop
------------------------------------------------------------------------
*2·68 : ⊢ (((p ⊃ q) ⊃ q) ⊃ p ∨ q)
*2·68 = Syll *2·67 *2·54

------------------------------------------------------------------------
-- ∗2.69  ⊢ : p ⊃ q .⊃. q :⊃: q ⊃ p .⊃. p
--
--  Dem. [*2·68.Perm.*2·62 q,p/p,q]
------------------------------------------------------------------------
*2·69 : ⊢ (((p ⊃ q) ⊃ q) ⊃ ((q ⊃ p) ⊃ p))
*2·69 = Syll *2·68 (Syll Perm *2·62)

------------------------------------------------------------------------
-- ∗2.73  ⊢ :. p ⊃ q .⊃: p ∨ q ∨ r .⊃. q ∨ r
--
--  Dem. [*2.621.*2.38]
------------------------------------------------------------------------
*2·73 : ⊢ ((p ⊃ q) ⊃ (p ∨ q ∨ r ⊃ q ∨ r))
*2·73 = Syll *2·621 *2·38

------------------------------------------------------------------------
-- ∗2.74  ⊢ : q ⊃ p .⊃: p ∨ q ∨ r .⊃. p ∨ r
--
--  Dem. [*2·73 q,p/p,q.Assoc.Syll]
------------------------------------------------------------------------
*2·74 : ⊢ ((q ⊃ p) ⊃ (p ∨ q ∨ r ⊃ p ∨ r))
*2·74 = Syll *2·73 (SyllImp (SyllOr Perm))

------------------------------------------------------------------------
-- ∗2.75  ⊢ :: p ∨ q .⊃: p .∨. q ⊃ r :⊃. p ∨ r
--
--  Dem. [*2·74 ~q/q.*2·53.*2·31]
------------------------------------------------------------------------
*2·75 : ⊢ (p ∨ q ⊃ (p ∨ (q ⊃ r)) ⊃ (p ∨ r))
*2·75 = Syll₄ Perm *2·53 *2·74 (SyllImp *2·31)

------------------------------------------------------------------------
-- ∗2.76  ⊢ : p .∨. q ⊃ r :⊃: p ∨ q .⊃. p ∨ r
--
--  Dem. [*2.75.Comm]
------------------------------------------------------------------------
*2·76 : ⊢ (p ∨ (q ⊃ r) ⊃ (p ∨ q ⊃ p ∨ r))
*2·76 = CommR *2·75

------------------------------------------------------------------------
-- ∗2.77  ⊢ : p .⊃. q ⊃ r :⊃: p ⊃ q .⊃. p ⊃ r
--
--  Dem. [*2·76 ~p/p]
------------------------------------------------------------------------
*2·77 : ⊢ ((p ⊃ q ⊃ r) ⊃ (p ⊃ q) ⊃ (p ⊃ r))
*2·77 = *2·76

------------------------------------------------------------------------
-- ∗2.8  ⊢ : q ∨ r .⊃: ~r ∨ s .⊃. q ∨ s
--
--  Dem. [*2·53.Perm; *2·38; Syll]
------------------------------------------------------------------------
*2·8 : ⊢ (q ∨ r ⊃ (~ r ∨ s ⊃ q ∨ s))
*2·8 = Syll₃ Perm *2·53 *2·38

------------------------------------------------------------------------
-- ∗2.81  ⊢ :: q .⊃. r ⊃ s :⊃: p ∨ q .⊃: p ∨ r .⊃. p ∨ s
--
--  Dem. [*2·76.Syll; Add; Syll]
------------------------------------------------------------------------
*2·81 : ⊢ ((q ⊃ r ⊃ s) ⊃ (p ∨ q ⊃ (p ∨ r ⊃ p ∨ s)))
*2·81 = Syll₃ Add *2·76 (SumR *2·76)

------------------------------------------------------------------------
-- ∗2.82  ⊢ : p ∨ q ∨ r .⊃: p ∨ ~r ∨ s .⊃. p ∨ q ∨ s
--
--  Dem. [*2.8.*2.81 q∨r,~r∨s,q∨s/q,r,s]
------------------------------------------------------------------------
*2·82 : ⊢ (p ∨ (q ∨ r) ⊃ (p ∨ (~ r ∨ s) ⊃ p ∨ (q ∨ s)))
*2·82 = MP *2·8 *2·81

------------------------------------------------------------------------
-- ∗2.83  ⊢ :: p .⊃. q ⊃ r :⊃: p .⊃. r ⊃ s :⊃: p .⊃. q ⊃ s
--
--  Dem. [*2.82 ~p,~q/p,q]
------------------------------------------------------------------------
*2·83 : ⊢ ((p ⊃ q ⊃ r) ⊃ (p ⊃ r ⊃ s) ⊃ (p ⊃ q ⊃ s))
*2·83 = *2·82

------------------------------------------------------------------------
-- ∗2.85  ⊢ :. p ∨ q .⊃. p ∨ r :⊃: p .∨. q ⊃ r
--
--  Dem.  [Add.Syll]
--          ⊢ :. p ∨ q .⊃. r :⊃. q ⊃ r                        (1)
--        ⊢ .*2.55.⊃ :: ~p .⊃: p ∨ r .⊃. r :
--        [Syll]    ⊃ :. p ∨ q .⊃. p ∨ r :⊃: p ∨ q .⊃. r :.
--        [(1).*2.83] ⊃ : p ∨ q .⊃. p ∨ r :⊃: q ⊃ r           (2)
--        ⊢ .(2).Comm.⊃
--          ⊢ :. p ∨ q .⊃. p ∨ r :⊃: ~p .⊃. q ⊃ r :
--        [*2.54] ⊃ : p .∨. q ⊃ r :.⊃ ⊢ .Prop
------------------------------------------------------------------------
*2·85 : ⊢ ((p ∨ q ⊃ p ∨ r) ⊃ p ∨ (q ⊃ r))
*2·85 = Syll (CommR (Syll₃ *2·55 *2·05 (SumR (SyllImp Add)))) *2·54

------------------------------------------------------------------------
-- ∗2.86  ⊢ : p ⊃ q .⊃. p ⊃ r :⊃: p .⊃. q ⊃ r
--
--  Dem. [*2·85 ~p/p]
------------------------------------------------------------------------
*2·86 : ⊢ (((p ⊃ q) ⊃ (p ⊃ r)) ⊃ (p ⊃ q ⊃ r))
*2·86 = *2·85

