module Star3 where

open import Star1
open import Star2

private
  variable
    p q r s : Prop

------------------------------------------------------------------------
-- ∗3. The Logical Product of Two Propositions
--
-- From Whitehead & Russell, Principia Mathematica (1910)
-- (star3_logical_product.md)
------------------------------------------------------------------------


------------------------------------------------------------------------
-- ∗3.01  p . q .=. ~(~p ∨ ~q)    Df
--
--  PM writes the logical product with a dot between propositions.
--  Captured by  infixl 25 _∙_  with  p ∙ q = ~ (~ p ∨ ~ q).
------------------------------------------------------------------------

infixl 25 _∙_
_∙_ : Prop → Prop → Prop
p ∙ q = ~ (~ p ∨ ~ q)

------------------------------------------------------------------------
-- ∗3.02  p ⊃ q ⊃ r .=. p ⊃ q . q ⊃ r    Df
--
--  The complex on the left is the logical product of the two
--  implications.  (Not invoked in ∗3.03–∗3.14.)
------------------------------------------------------------------------

⊃⊃ : Prop → Prop → Prop → Prop
⊃⊃ p q r = (p ⊃ q) ∙ (q ⊃ r)

------------------------------------------------------------------------
-- ∗3.03  Given two asserted elementary schematic functions
--        ⊢ . φp  and  ⊢ . ψp,  we have  ⊢ . φp . ψp .
--
--  Dem.
--    [*1·7.*1·72.*2·11]  (1)
--    [(1).*2·32.(*1·01)]  (2)
--    [(2).(*3·01)]  (3)
--    [(3).*1·11]  Prop
------------------------------------------------------------------------
*3·03 : (∀ {x} → ⊢ (φ x))
      → (∀ {x} → ⊢ (ψ x))
      → (∀ {x} → ⊢ (φ x ∙ ψ x))
*3·03 f g = *1·1 g (*1·1 f (MP *2·11 *2·32))

------------------------------------------------------------------------
-- ∗3.1  ⊢ : p . q .⊃. ~(~p ∨ ~q)
--
--  Dem. [Id.(*3.01)]
------------------------------------------------------------------------
*3·1 : ⊢ (p ∙ q ⊃ ~ (~ p ∨ ~ q))
*3·1 = Id

------------------------------------------------------------------------
-- ∗3.11  ⊢ : ~(~p ∨ ~q) .⊃. p . q
--
--  Dem. [Id.(*3.01)]
------------------------------------------------------------------------
*3·11 : ⊢ (~ (~ p ∨ ~ q) ⊃ p ∙ q)
*3·11 = Id

------------------------------------------------------------------------
-- ∗3.12  ⊢ : ~p .∨. ~q .∨. p . q
--
--  Dem. [*2.11 (~p ∨ ~q)/p]
------------------------------------------------------------------------
*3·12 : ⊢ (~ p ∨ ~ q ∨ (p ∙ q))
*3·12 = *2·11

------------------------------------------------------------------------
-- ∗3.13  ⊢ : ~(p . q) .⊃. ~p ∨ ~q
--
--  Dem. [*3.11.Transp]
------------------------------------------------------------------------
*3·13 : ⊢ (~ (p ∙ q) ⊃ ~ p ∨ ~ q)
*3·13 = Syll (TranspR *3·11) *2·14

------------------------------------------------------------------------
-- ∗3.14  ⊢ : ~p ∨ ~q .⊃. ~(p . q)
--
--  Dem. [*3.1.Transp]
------------------------------------------------------------------------
*3·14 : ⊢ (~ p ∨ ~ q ⊃ ~ (p ∙ q))
*3·14 = Syll *2·12 (TranspR *3·1)

------------------------------------------------------------------------
-- ∗3.2  ⊢ :. p .⊃: q .⊃. p . q
--
--  Dem. [*3·12]
------------------------------------------------------------------------
*3·2 : ⊢ (p ⊃ q ⊃ p ∙ q)
*3·2 = MP *3·12 *2·32

------------------------------------------------------------------------
-- ∗3.21  ⊢ : q .⊃: p .⊃. p . q
--
--  Dem. [*3.2.Comm]
------------------------------------------------------------------------
*3·21 : ⊢ (q ⊃ p ⊃ p ∙ q)
*3·21 = CommR *3·2

------------------------------------------------------------------------
-- ∗3.22  ⊢ : p . q .⊃. q . p
--
--  One form of the commutative law for logical multiplication.
--
--  Dem. [*3·13 q,p/p,q.Perm.*3·14.Transp]
------------------------------------------------------------------------
*3·22 : ⊢ (p ∙ q ⊃ q ∙ p)
*3·22 = MP (Syll₃ (*3·13) Perm *3·14) *2·17

------------------------------------------------------------------------
-- ∗3.24  ⊢ . ~(p . ~p)
--
--  The law of contradiction.
--
--  Dem. [*2·11 ~p/p.*3·14 ~p/q]
------------------------------------------------------------------------
*3·24 : ⊢ (~ (p ∙ ~ p))
*3·24 = MP *2·11 *3·14

------------------------------------------------------------------------
-- ∗3.26  ⊢ : p . q .⊃. p
--
--  Dem. [*2·02 q,p/p,q; (*1·01); *2·31; *2·53 ~p∨~q,p/p,q; (*3·01)]
------------------------------------------------------------------------
*3·26 : ⊢ (p ∙ q ⊃ p)
*3·26 = Syll *3·1 (MP₂ *2·02 *2·31 *2·53)

------------------------------------------------------------------------
-- ∗3.27  ⊢ : p . q .⊃. q
--
--  Dem. [*3·22.*3·26 q,p/p,q]
--
--  ∗3.26.27 will both be called the "principle of simplification" (Simp).
------------------------------------------------------------------------
*3·27 : ⊢ (p ∙ q ⊃ q)
*3·27 = Syll *3·22 *3·26

------------------------------------------------------------------------
-- ∗3.3  ⊢ :. p . q .⊃. r :⊃: p .⊃. q ⊃ r
--
--  Exportation (Exp).
--  Dem. [Id.(*3·01).Transp.Id.(*1·01).Comm.Transp.Syll]
------------------------------------------------------------------------
*3·3 : ⊢ ((p ∙ q ⊃ r) ⊃ (p ⊃ q ⊃ r))
*3·3 =
  Syll₄ Id (Syll Transp (SumR *2·14)) Comm (SumR *2·17)

Exp : ⊢ ((p ∙ q ⊃ r) ⊃ (p ⊃ q ⊃ r))
Exp = *3·3

-- Modus ponens with exportation (*3·3).
MPExp : ⊢ ((p ∙ q) ⊃ r) → ⊢ (p ⊃ q ⊃ r)
MPExp hp = MP hp Exp

------------------------------------------------------------------------
-- ∗3.31  ⊢ :. p .⊃. q ⊃ r :⊃: p . q .⊃. r
--
--  Importation (Imp).
--  Dem. [Id.(*1·01).*2·31.*2·53 ~p∨~q,r/p,q.(*3·01)]
------------------------------------------------------------------------
*3·31 : ⊢ ((p ⊃ q ⊃ r) ⊃ (p ∙ q ⊃ r))
*3·31 = Syll *2·31 *2·53

Imp : ⊢ ((p ⊃ q ⊃ r) ⊃ (p ∙ q ⊃ r))
Imp = *3·31

-- Modus ponens with importation (*3·31).
MPImp : ⊢ (p ⊃ q ⊃ r) → ⊢ ((p ∙ q) ⊃ r)
MPImp hp = MP hp Imp

------------------------------------------------------------------------
-- ∗3.33  ⊢ : p ⊃ q . q ⊃ r .⊃. p ⊃ r
--
--  Dem. [Syll.Imp]
------------------------------------------------------------------------
*3·33 : ⊢ (((p ⊃ q) ∙ (q ⊃ r)) ⊃ (p ⊃ r))
*3·33 = Syll *3·22 (MPImp *2·05)

------------------------------------------------------------------------
-- ∗3.34  ⊢ : q ⊃ r . p ⊃ q .⊃. p ⊃ r
--
--  Dem. [Syll.Imp]
------------------------------------------------------------------------
*3·34 : ⊢ (((q ⊃ r) ∙ (p ⊃ q)) ⊃ (p ⊃ r))
*3·34 = Syll *3·22 (MPImp *2·06)

------------------------------------------------------------------------
-- ∗3.35  ⊢ : p . p ⊃ q .⊃. q
--
--  Principle of assertion (Ass).  Dem. [*2·27.Imp]
------------------------------------------------------------------------
*3·35 : ⊢ ((p ∙ (p ⊃ q)) ⊃ q)
*3·35 = MPImp *2·27

------------------------------------------------------------------------
-- ∗3.37  ⊢ :. p . q .⊃. r :⊃: p . ~ r .⊃. ~ q
--
--  Another form of transposition.
--  Dem. [Transp.Syll.Exp.Imp.Syll]
------------------------------------------------------------------------
*3·37 : ⊢ ((p ∙ q ⊃ r) ⊃ (p ∙ ~ r ⊃ ~ q))
*3·37 = Syll₃ *3·3 (SumR Transp) *3·31

------------------------------------------------------------------------
-- ∗3.4  ⊢ : p . q .⊃. p ⊃ q
--
--  Dem. [*2·51.Transp.(*1·01.*3·01)]
------------------------------------------------------------------------
*3·4 : ⊢ ((p ∙ q) ⊃ (p ⊃ q))
*3·4 = Syll Id (Syll *2·51 (SumR *2·14))

------------------------------------------------------------------------
-- ∗3.41  ⊢ :. p ⊃ r .⊃: p . q .⊃. r
--
--  Dem. [*3·26.Syll]
------------------------------------------------------------------------
*3·41 : ⊢ ((p ⊃ r) ⊃ ((p ∙ q) ⊃ r))
*3·41 = SyllImp *3·26

------------------------------------------------------------------------
-- ∗3.42  ⊢ :. q ⊃ r .⊃: p . q .⊃. r
--
--  Dem. [*3·27.Syll]
------------------------------------------------------------------------
*3·42 : ⊢ ((q ⊃ r) ⊃ ((p ∙ q) ⊃ r))
*3·42 = SyllImp *3·27

------------------------------------------------------------------------
-- ∗3.43  ⊢ :. p ⊃ q . p ⊃ r .⊃: p .⊃. q . r
--
--  Principle of composition (Comp).  Dem. [*3·2.Syll.*2·77.Imp]
------------------------------------------------------------------------
*3·43 : ⊢ (((p ⊃ q) ∙ (p ⊃ r)) ⊃ (p ⊃ (q ∙ r)))
*3·43 = MP (Syll (SumR *3·2) *2·77) *3·31

------------------------------------------------------------------------
-- ∗3.44  ⊢ : q ⊃ p . r ⊃ p .⊃: q ∨ r .⊃. p
--
--  Dem. [Syll.*2·6.Exp.Comm.Imp.*2·53.Syll]
------------------------------------------------------------------------
*3·44 : ⊢ (((q ⊃ p) ∙ (r ⊃ p)) ⊃ (q ∨ r ⊃ p))
*3·44 =
  Syll (MP (Syll *3·26 *2·61) (MP (Syll *3·27 *2·05) *2·83))
    (SyllImp *2·53)

------------------------------------------------------------------------
-- ∗3.45  ⊢ :. p ⊃ q .⊃: p . r .⊃. q . r
--
--  Principle of the factor (Fact).  Dem. [Syll ~(r)/r.Transp.(*1.01.*3.01)]
------------------------------------------------------------------------
*3·45 : ⊢ ((p ⊃ q) ⊃ ((p ∙ r) ⊃ (q ∙ r)))
*3·45 = Syll₃ *2·06 Transp Id

------------------------------------------------------------------------
-- ∗3.47  ⊢ :. p ⊃ r . q ⊃ s .⊃: p . q .⊃. r . s
--
--  Praeclarum theorema.
--  Dem. [*3·26.Fact.*3·22; *3·27.Fact.*3·22; (1).(2).*3·03.*2·83]
------------------------------------------------------------------------
*3·47 : ⊢ (((p ⊃ r) ∙ (q ⊃ s)) ⊃ ((p ∙ q) ⊃ (r ∙ s)))
*3·47 =
  MP (Syll *3·27 (Syll *3·45 (SumR *3·22)))
    (MP (Syll *3·26 (Syll *3·45 (SumR *3·22))) *2·83)

------------------------------------------------------------------------
-- ∗3.48  ⊢ :. p ⊃ r . q ⊃ s .⊃: p ∨ q .⊃. r ∨ s
--
--  The analogue of ∗3·47.
--  Dem. [*3·26.Sum.Perm; *3·27.Sum.Perm; (1).(2).*2·83]
------------------------------------------------------------------------
*3·48 : ⊢ (((p ⊃ r) ∙ (q ⊃ s)) ⊃ (p ∨ q ⊃ r ∨ s))
*3·48 =
  MP (Syll *3·27 (Syll *2·38 (SumR Perm)))
    (MP (Syll *3·26 (Syll *2·38 (SumR Perm))) *2·83)
