------------------------------------------------------------------------
-- ∗5·1  ⊢ : p . q .⊃. p ≡ q
--
--  Dem. [*3·4.*3·22]
------------------------------------------------------------------------
*5·1 : ⊢ ((p ∙ q) ⊃ (p ≡ q))
*5·1 = Comp *3·4 (Syll *3·22 *3·4)

--  Case split on  p ∨ ~p  (via *2·11 and *3·44).
ByCasesEM : ⊢ (p ⊃ r) → ⊢ (~ p ⊃ r) → ⊢ r
ByCasesEM hp h~p =
  MP *2·11 (Cases hp h~p)


------------------------------------------------------------------------
